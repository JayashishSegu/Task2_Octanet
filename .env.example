# ---------------------------------------------------------------------------
# Website Roast — environment variables
# Copy this file to .env.local for local development.
# All variables are OPTIONAL: without them the app falls back to a fully
# deterministic, evidence-based heuristic engine (no fake criticism, ever).
# ---------------------------------------------------------------------------

# OpenAI-compatible API key. When set, the roast copy is written by an LLM
# via the Vercel AI SDK (grounded strictly in the collected evidence).
OPENAI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (Azure, Together, Groq,
# LM Studio, OpenRouter, ...). Leave empty for api.openai.com.
OPENAI_BASE_URL=

# Optional: model id to use. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional: Google PageSpeed Insights API key for real Lighthouse metrics
# (performance / accessibility / SEO / best-practices scores + Core Web Vitals).
# Get one free at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
